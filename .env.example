# ==========================================
# AI Image Generation Studio - Environment Configuration
# ==========================================

# Optional Hugging Face Token (required only for private models or Hugging Face Inference API fallback)
HF_TOKEN=your_huggingface_token_here

# Stable Diffusion Model ID
# Options:
#   stabilityai/sd-turbo (Ultra fast, 1-4 steps, low VRAM)
#   runwayml/stable-diffusion-v1-5 (Standard Stable Diffusion 1.5)
#   CompVis/stable-diffusion-v1-4
DEFAULT_MODEL_ID=runwayml/stable-diffusion-v1-5

# Execution Device override: 'auto', 'cuda', or 'cpu'
DEVICE=auto

# Precision: 'true' to use float16 on CUDA (saves 50% VRAM), 'false' for float32
USE_FP16=true

# Low VRAM mode (enables attention slicing and model CPU offloading if needed)
LOW_VRAM_MODE=true

# Fallback to Hugging Face Inference API if local hardware cannot run SD
HF_API_FALLBACK=false

# Directory for storing output generations
OUTPUTS_DIR=outputs

